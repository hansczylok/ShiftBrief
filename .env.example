# Kopieren nach .env und Werte eintragen. .env NIE committen.

# Wo Gemma 4 läuft: gemini = Gemini API (Key), vertex = eigener Vertex-AI-Endpoint
GEMMA_BACKEND=gemini

# Gemma 4 über Gemini API (Key aus Google AI Studio)
GEMMA_API_KEY=
# Exakte Modell-ID in AI Studio nachschauen (Modellliste), ggf. anpassen
GEMMA_MODEL=gemma-4-26b-a4b-it
# true = Gemma denkt vor der Antwort nach (besser, aber langsamer)
GEMMA_THINKING=false

# Gemma 4 auf Vertex AI (Model Garden, Dedicated Endpoint). Auth via:
#   gcloud auth application-default login
# URL: https://<DEDICATED_ENDPOINT_DNS>/v1/projects/<PROJEKTNUMMER>/locations/<REGION>/endpoints/<ENDPOINT_ID>:predict
VERTEX_ENDPOINT_URL=
VERTEX_MAX_TOKENS=1024

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2

# SYSTEM_PROMPT=Du bist ...
