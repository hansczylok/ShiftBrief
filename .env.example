# Kopieren nach .env und Werte eintragen. .env NIE committen.

# gemini = Gemma 4 über Gemini API (Google AI Studio), ollama = lokal/offline
GEMMA_BACKEND=gemini
GEMINI_API_KEY=
# Exakte Modell-ID in AI Studio nachschauen (Modellliste), ggf. anpassen
GEMMA_MODEL=gemma-4-26b-a4b-it
# true = Gemma denkt vor der Antwort nach (besser, aber langsamer)
GEMMA_THINKING=false

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2

# SYSTEM_PROMPT=Du bist ...
