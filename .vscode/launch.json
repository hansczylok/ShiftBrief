{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (uvicorn, Debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "Backend (Ollama offline)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "envFile": "${workspaceFolder}/.env",
      "env": { "GEMMA_BACKEND": "ollama" },
      "justMyCode": true
    }
  ]
}
